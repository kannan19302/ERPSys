# ============================================================
# UniERP Dev Container — lightweight, no build steps.
# The monorepo is bind-mounted at runtime for live-reload.
# Build: docker build -f Dockerfile.dev -t unerp-dev .
# ============================================================
FROM node:22-alpine

# Install tini for proper signal handling (graceful shutdown of dev servers)
RUN apk add --no-cache tini bash

# Toolchain for native modules.
#
# `isolated-vm` — the V8 isolate the extension sandbox runs on (ADR-009) — is a
# native addon and compiles from source. Without these the api container died at
# boot with `Failed in 648ms at /app/node_modules/isolated-vm` followed by
# ELIFECYCLE, which reads as a dependency problem and is actually a missing
# compiler. Alpine needs libc++ headers as well as g++ because isolated-vm links
# against the C++ standard library.
RUN apk add --no-cache python3 make g++ libc6-compat libstdc++

# Enable corepack (ships with Node 22) and activate pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copy the entrypoint scripts (default combined one, plus the split
# api/web variants used by docker-compose.dev.yml's separate services).
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY scripts/docker-entrypoint-api.sh /usr/local/bin/docker-entrypoint-api.sh
COPY scripts/docker-entrypoint-web.sh /usr/local/bin/docker-entrypoint-web.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    /usr/local/bin/docker-entrypoint-api.sh \
    /usr/local/bin/docker-entrypoint-web.sh

# Use tini as init to reap zombie processes from dev watchers
ENTRYPOINT ["/sbin/tini", "--"]

# Default command: run the entrypoint
CMD ["/usr/local/bin/docker-entrypoint.sh"]
