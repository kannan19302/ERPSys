{
  "name": "@unerp/ui",
  "version": "0.0.1",
  "private": true,
  "description": "UniERP Design System — backward-compat facade over @unerp/ui-* packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./src/styles/globals.css",
    "./tokens": "./src/tokens/design-tokens.css",
    "./charts": {
      "types": "./charts.d.ts",
      "import": "./charts.js",
      "require": "./charts.cjs",
      "default": "./charts.js"
    },
    "./components": {
      "types": "./components.d.ts",
      "import": "./components.js",
      "require": "./components.cjs",
      "default": "./components.js"
    },
    "./layout": {
      "types": "./layout.d.ts",
      "import": "./layout.js",
      "require": "./layout.cjs",
      "default": "./layout.js"
    },
    "./data-grid": {
      "types": "./data-grid.d.ts",
      "import": "./data-grid.js",
      "require": "./data-grid.cjs",
      "default": "./data-grid.js"
    },
    "./dashboard": {
      "types": "./dashboard.d.ts",
      "import": "./dashboard.js",
      "require": "./dashboard.cjs",
      "default": "./dashboard.js"
    },
    "./notifications": {
      "types": "./notifications.d.ts",
      "import": "./notifications.js",
      "require": "./notifications.cjs",
      "default": "./notifications.js"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "import": "./hooks.js",
      "require": "./hooks.cjs",
      "default": "./hooks.js"
    },
    "./icons": {
      "types": "./icons.d.ts",
      "import": "./icons.js",
      "require": "./icons.cjs",
      "default": "./icons.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "import": "./theme.js",
      "require": "./theme.cjs",
      "default": "./theme.js"
    },
    "./utils": {
      "types": "./utils.d.ts",
      "import": "./utils.js",
      "require": "./utils.cjs",
      "default": "./utils.js"
    },
    "./form-engine": {
      "types": "./form-engine.d.ts",
      "import": "./form-engine.js",
      "require": "./form-engine.cjs",
      "default": "./form-engine.js"
    },
    "./workflow": {
      "types": "./workflow.d.ts",
      "import": "./workflow.js",
      "require": "./workflow.cjs",
      "default": "./workflow.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unerp/ui-charts": "workspace:*",
    "@unerp/ui-components": "workspace:*",
    "@unerp/ui-dashboard": "workspace:*",
    "@unerp/ui-data-grid": "workspace:*",
    "@unerp/ui-hooks": "workspace:*",
    "@unerp/ui-icons": "workspace:*",
    "@unerp/ui-layout": "workspace:*",
    "@unerp/ui-notifications": "workspace:*",
    "@unerp/ui-theme": "workspace:*",
    "@unerp/ui-tokens": "workspace:*",
    "@unerp/ui-utils": "workspace:*",
    "lucide-react": "^0.460.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@unerp/config": "workspace:*",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
