{
  "name": "@unerp/ui",
  "version": "0.0.1",
  "private": true,
  "description": "UniERP Design System — one package, subpath exports (PLATFORM_ARCHITECTURE.md § 7.2)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./src/styles/globals.css",
    "./tokens/design-tokens.css": "./src/tokens/design-tokens.css",
    "./tokens/base.css": "./src/tokens/base.css",
    "./tokens/charts.css": "./src/tokens/charts.css",
    "./tokens/index.css": "./src/tokens/index.css",
    "./tokens/studio.css": "./src/tokens/studio.css",
    "./tokens/themes/*": "./src/tokens/themes/*",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.js",
      "default": "./dist/layout/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js",
      "require": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid/index.d.ts",
      "import": "./dist/data-grid/index.js",
      "require": "./dist/data-grid/index.js",
      "default": "./dist/data-grid/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js",
      "require": "./dist/dashboard/index.js",
      "default": "./dist/dashboard/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.js",
      "default": "./dist/notifications/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./form-engine": {
      "types": "./dist/form-engine/index.d.ts",
      "import": "./dist/form-engine/index.js",
      "require": "./dist/form-engine/index.js",
      "default": "./dist/form-engine/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.js",
      "default": "./dist/workflow/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "lucide-react": "^0.460.0",
    "recharts": "^3.9.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@unerp/config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^0.1.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
